{
  "name": "@tauri-motrix/ux-base",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "docs:dev": "storybook dev -p 6006",
    "docs:build": "storybook build"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "catalog:stylex",
    "@stylexswc/rs-compiler": "catalog:stylex",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rslib/core": "catalog:",
    "@stylexswc/unplugin": "catalog:stylex",
    "@types/react": "catalog:",
    "react": "catalog:",
    "storybook": "^10.6.2",
    "storybook-addon-rslib": "^3.6.1",
    "storybook-react-rsbuild": "^3.6.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:stylex",
    "@tauri-motrix/unified-base": "workspace:*"
  }
}
